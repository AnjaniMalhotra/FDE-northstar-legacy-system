# Copy this file to .env and fill in real values. .env itself is gitignored — never commit it.
#
# Legacy system only — no AI/POC config here (no LLM provider, no vector store, no AI console
# login). Trimmed from the parent project's .env.example, which also configures the separate AI
# copilot.

# --- Database connection ---
# Local Postgres, Docker Compose, or the Cloud SQL Auth Proxy all just look like a TCP host/port
# from here. Leave DB_HOST as-is for local/Docker; the Auth Proxy defaults to 127.0.0.1:5432 too.
DB_HOST=localhost
DB_PORT=5432

# Admin credentials: your own OS user locally; the Cloud SQL "postgres" admin user in the cloud
# (see deploy/terraform, which creates this user and prints the generated password).
# Used by bootstrap.sh to create/migrate the database below.
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

# --- northstar_web database (backend/northstar_web_api/ + frontend/northstar_web/) ---
# This project's one database. The app role is read/write, used only by
# backend/northstar_web_api/. The FDE role is strictly read-only — the
# credentials a real FDE (or the sibling AI copilot project) connects
# to Postgres with directly, bypassing the API entirely. See
# backend/scripts/northstar_web_security.sql.
NORTHSTAR_WEB_DB_NAME=northstar_web
NORTHSTAR_WEB_APP_PASSWORD=change_this_local_dev_password
NORTHSTAR_WEB_FDE_USER=northstar_web_fde_ro
NORTHSTAR_WEB_FDE_PASSWORD=change_this_local_dev_password

# --- Cloud Run + Cloud SQL only — leave blank for local/Docker ---
# Set by Cloud Run itself (see deploy/terraform/run.tf) to the Cloud SQL instance's
# "PROJECT:REGION:INSTANCE" connection name. When set, backend/northstar_web_api/db.py connects
# over the Unix socket Cloud Run mounts at /cloudsql/<this value> instead of DB_HOST:DB_PORT.
INSTANCE_CONNECTION_NAME=
