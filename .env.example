# Copy this file to .env and fill in real values. .env itself is gitignored — never commit it.
#
# The portal and the AI copilot are one project here — this file configures both.

# --- Database connection ---
DB_HOST=localhost
DB_PORT=5432

# Admin credentials: your own OS user, used by bootstrap.sh to create/migrate the database below.
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

# --- northstar_web database (backend/northstar_web_api/ + frontend/northstar_web/) ---
# This project's one database. The app role is read/write, used only by
# backend/northstar_web_api/. The FDE role is strictly read-only — the credentials a real FDE
# connects to Postgres with directly, bypassing the API entirely. See
# backend/scripts/northstar_web_security.sql.
NORTHSTAR_WEB_DB_NAME=northstar_web
NORTHSTAR_WEB_APP_PASSWORD=change_this_local_dev_password
NORTHSTAR_WEB_FDE_USER=northstar_web_fde_ro
NORTHSTAR_WEB_FDE_PASSWORD=change_this_local_dev_password

# --- AI copilot (copilot/ + backend/copilot_api/) ---
# Same database as above (DB_NAME here is the same value as NORTHSTAR_WEB_DB_NAME — copilot/'s
# own code reads it under this name). Additive tables/roles: backend/scripts/
# northstar_web_ai_schema.sql + northstar_web_ai_security.sql.
DB_NAME=northstar_web

# The agent's own dedicated, low-privilege database role (read-only on the portal's own tables,
# insert-only on the AI's own) — created by northstar_web_ai_security.sql.
DB_AGENT_USER=northstar_web_agent
DB_AGENT_PASSWORD=change_this_local_dev_password

# Human identity for the AI's own login (copilot/identity.py) — a real email/password form,
# checked entirely inside Postgres (pgcrypto), against the SAME users table the portal already
# logs in against. 3 roles: ANALYST/MANAGER/ADMIN.
AUTH_MODE=LOCAL_DEV
DB_ANALYST_PASSWORD=change_this_local_dev_password
DB_MANAGER_PASSWORD=change_this_local_dev_password
DB_HUMAN_ADMIN_PASSWORD=change_this_local_dev_password

# Which AI console tabs are available — PART_2 (default) is the finished set (Pending Approvals
# included); PART_1 is a narrower earlier stage.
POC_DEMO_STAGE=PART_2

# --- Vector store (RAG policy search) ---
# Get a free API key at https://app.pinecone.io. Never paste a real key in chat.
PINECONE_API_KEY=

# --- Reasoning LLM ---
# OLLAMA (default) = fully local, free, no API key — requires the Ollama app running locally with
# a model pulled (e.g. `ollama pull llama3.2:3b`). OPENAI = needed because small local models
# weren't reliable enough for this agent's task. Never paste a real key in chat.
LLM_PROVIDER=OLLAMA
OLLAMA_MODEL=llama3.2:3b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
